<?xml version="1.0" encoding="UTF-8"?>
<!--
  DLCV RK3576 Linux SDK Release Manifest
  Target: RK3576 TaishanPi-3 / LubanCat compatible
  Branch: linux
  Maintained by: https://github.com/OKayJH
-->
<manifest>
  <!-- Remote definitions -->
  <remote name="lubancat" fetch="https://github.com/LubanCat/"/>
  <remote name="dlcv"     fetch="https://github.com/OKayJH/"/>

  <!-- Defaults -->
  <default remote="lubancat" sync-j="4"/>

  <!-- ========== Manifest ========== -->
  <project name="DLCV_SDK" path="DLCV_SDK"
           remote="dlcv"
           revision="linux"
           dest-branch="linux" clone-depth="1">
    <linkfile src="README.md" dest="README.md"/>
  </project>

  <!-- ========== BSP Core ========== -->
  <project name="device" path="device/rockchip"
           remote="dlcv"
           revision="imx334"
           dest-branch="imx334" clone-depth="1">
    <linkfile src="common/scripts/build.sh" dest="build.sh"/>
    <linkfile src="common/Makefile"         dest="Makefile"/>
    <linkfile src="common/scripts/rkflash.sh" dest="rkflash.sh"/>
  </project>

  <!-- ========== Bootloader ========== -->
  <project name="u-boot"
           remote="dlcv"
           revision="rk3576"
           dest-branch="rk3576" clone-depth="1"/>

  <project name="rkbin"
           remote="dlcv"
           revision="rk3576"
           dest-branch="rk3576" clone-depth="1"/>

  <!-- ========== Kernel ========== -->
  <project name="kernel" path="kernel-5.10"
           revision="lbc-develop-5.10"
           dest-branch="lbc-develop-5.10" clone-depth="1"/>

  <project name="kernel" path="kernel-6.1"
           remote="dlcv"
           revision="imx334"
           dest-branch="imx334" clone-depth="1">
    <linkfile src="." dest="kernel"/>
  </project>

  <!-- ========== Rootfs / Distro ========== -->
  <project name="debian12"
           remote="dlcv"
           revision="imx334"
           dest-branch="imx334" clone-depth="1"/>



  <!-- ========== Tools ========== -->
  <project name="tools"
           revision="master"
           dest-branch="master" clone-depth="1"/>

  <!-- ========== Prebuilt Toolchains ========== -->
  <project name="gcc-arm-10.3-2021.07-x86_64-aarch64-none-linux-gnu"
           path="prebuilts/gcc/linux-x86/aarch64/gcc-arm-10.3-2021.07-x86_64-aarch64-none-linux-gnu"
           revision="adbb295a970c4b39dc487c95226fe84d2c460072"
           clone-depth="1"/>

  <project name="gcc-arm-10.3-2021.07-x86_64-arm-none-linux-gnueabihf"
           path="prebuilts/gcc/linux-x86/arm/gcc-arm-10.3-2021.07-x86_64-arm-none-linux-gnueabihf"
           revision="2e89382ca3f8c34086272509ae4d7a5c340ffafc"
           clone-depth="1"/>
</manifest>
